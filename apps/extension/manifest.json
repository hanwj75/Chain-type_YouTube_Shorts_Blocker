{
  "manifest_version": 3,
  "name": "chain-short-man",
  "version": "0.0.0",
  "description": "Worker state-driven Chain Short Man.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "dist/apps/extension/src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/apps/extension/src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Shorts Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
